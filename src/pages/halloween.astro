---
import Layout from '../layouts/Layout.astro';

// Halloween limited-edition freebies. Add/swap items as new ones drop.
const freebies = [
	{ title: 'Printable Bookmarks', type: 'Print & cut', preview: '/halloween/bookmarks.png', file: '/halloween/bookmarks.pdf', btn: 'Download PDF' },
	{ title: 'Coloring Sheet', type: 'Print & color', preview: '/halloween/coloring.png', file: '/halloween/coloring.pdf', btn: 'Download PDF' },
	{ title: 'Printable Stickers', type: 'Print & cut', preview: '/halloween/stickers.png', file: '/halloween/stickers.pdf', btn: 'Download PDF' },
	{ title: 'Door Hanger', type: 'Print & cut', preview: '/halloween/door-hanger.png', file: '/halloween/door-hanger.pdf', btn: 'Download PDF' },
	{ title: 'Phone Wallpaper', type: 'For your phone', preview: '/halloween/phone-wallpaper-preview.jpg', file: '/halloween/phone-wallpaper.png', btn: 'Download' },
	{ title: 'Desktop Wallpaper', type: 'For your computer', preview: '/halloween/desktop-wallpaper-preview.jpg', file: '/halloween/desktop-wallpaper.png', btn: 'Download' },
];
---

<Layout title="Halloween Freebies - Japanezy Arts">
	<section class="hw-section">
		<a href="/" class="close-btn" aria-label="Back to home">&times;</a>
		<span class="hw-limited">✨ Limited Edition · This Month Only ✨</span>
		<h2>🎃 Halloween Freebies 👻</h2>
		<p class="hw-subtitle">Free spooky-cute printables and wallpapers — grab them before they vanish into the night!</p>

		<div class="hw-grid">
			{freebies.map((f) => (
				<div class="hw-card">
					<div class="hw-thumb"><img src={f.preview} alt={f.title} loading="lazy" decoding="async" /></div>
					<div class="hw-info">
						<span class="hw-type">{f.type}</span>
						<h4>{f.title}</h4>
						<a href={f.file} download class="hw-dl">
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
							{f.btn}
						</a>
					</div>
				</div>
			))}
		</div>

		<div class="notice">
			<p class="notice-title">NOTICE</p>
			<p>These freebies are for personal use only. Please don't redistribute or sell them.</p>
		</div>
	</section>
</Layout>

<style>
	.close-btn {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 2rem;
		color: #6B3E2E;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
		line-height: 1;
		opacity: 0.5;
		transition: opacity 0.2s;
	}
	.close-btn:hover { opacity: 1; }

	.hw-section {
		max-width: 1000px;
		margin: 2rem auto;
		padding: 2.5rem 2rem 3rem;
		text-align: center;
		position: relative;
		z-index: 1;
		background: linear-gradient(160deg, #f3ecff, #ffeede);
		border-radius: 28px;
		border: 2px solid #e4d4ff;
	}

	.hw-limited {
		display: inline-block;
		background: linear-gradient(135deg, #9c73d6, #ffb37a);
		color: #fff;
		font-family: 'Baloo 2', cursive;
		font-weight: 800;
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.35rem 1rem;
		border-radius: 999px;
		margin-bottom: 0.9rem;
		box-shadow: 0 2px 10px rgba(156, 115, 214, 0.35);
	}

	.hw-section h2 {
		font-family: 'Baloo 2', cursive;
		font-size: 2rem;
		color: #5a3a82;
		margin: 0 0 0.5rem;
	}

	.hw-subtitle {
		font-family: 'Nunito', sans-serif;
		font-size: 1rem;
		color: #6B3E2E;
		opacity: 0.8;
		max-width: 540px;
		margin: 0 auto 2rem;
		line-height: 1.5;
	}

	.hw-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.5rem;
	}

	.hw-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border-radius: 18px;
		overflow: hidden;
		border: 2px solid #ffe3ec;
		box-shadow: 0 2px 12px rgba(107, 62, 46, 0.1);
		transition: all 0.25s;
	}
	.hw-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 6px 20px rgba(156, 115, 214, 0.22);
	}

	.hw-thumb {
		background: #faf5ff;
		line-height: 0;
		aspect-ratio: 1 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.hw-thumb img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 0.5rem;
		box-sizing: border-box;
	}

	.hw-info {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.hw-type {
		font-family: 'Nunito', sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #9c73d6;
	}
	.hw-info h4 {
		font-family: 'Baloo 2', cursive;
		font-size: 1.05rem;
		color: #6B3E2E;
		margin: 0;
	}
	.hw-dl {
		display: inline-flex;
		align-items: center;
		font-family: 'Baloo 2', cursive;
		font-weight: 700;
		font-size: 0.9rem;
		padding: 0.55rem 1.3rem;
		border-radius: 12px;
		text-decoration: none;
		color: #fff;
		background: linear-gradient(135deg, #ffb37a, #f0839f);
		box-shadow: 0 3px 12px rgba(240, 131, 159, 0.35);
		transition: transform 0.2s;
		margin-top: 0.2rem;
	}
	.hw-dl:hover { transform: translateY(-2px) scale(1.04); }

	.notice {
		background: #fff;
		border-radius: 12px;
		padding: 1.1rem 1.4rem;
		max-width: 560px;
		margin: 2rem auto 0;
		text-align: left;
		border: 1px solid #e4d4ff;
	}
	.notice-title {
		font-family: 'Baloo 2', cursive;
		font-weight: 800;
		color: #5a3a82;
		font-size: 0.95rem;
		margin-bottom: 0.4rem;
	}
	.notice p {
		font-family: 'Nunito', sans-serif;
		font-size: 0.8rem;
		color: #6B3E2E;
		opacity: 0.75;
		line-height: 1.6;
		margin: 0;
	}

	@media (max-width: 600px) {
		.hw-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
		.hw-section { padding: 1.75rem 1rem 2rem; }
		.hw-section h2 { font-size: 1.5rem; }
		.close-btn { top: 1rem; right: 1rem; font-size: 1.75rem; }
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import { prints } from '../data/prints';
---

<Layout title="3D Prints - Japanezy Arts">
	<section class="prints-section">
		<a href="/" class="close-btn" aria-label="Back to home">&times;</a>
		<h2>3D Prints</h2>
		<p class="prints-subtitle">Free downloadable files of your favorite characters!</p>

		<!-- Limited Edition corner tab (always visible; the popup covers it when open) -->
		<button class="le-tab" id="le-tab" aria-label="Limited edition once-a-month print">
			<span class="le-tab-emoji" aria-hidden="true">🎃</span>
			<span class="le-tab-text">Limited Edition<br /><small>Once-a-Month Print</small></span>
		</button>

		<!-- Halloween limited-edition popup -->
		<div class="le-overlay" id="le-overlay" role="dialog" aria-modal="true" aria-labelledby="le-title">
			<div class="le-modal">
				<button class="le-close" id="le-close" aria-label="Close">&times;</button>
				<div class="le-bats" aria-hidden="true"><img src="/halloween-bat-1.png" alt="" /><img src="/halloween-bat-2.png" alt="" /><img src="/halloween-bat-3.png" alt="" /></div>
				<img class="le-pumpkin-img" src="/halloween-rosey.png" alt="" aria-hidden="true" />
				<span class="le-badge">Limited Edition</span>
				<h2 class="le-title" id="le-title">This Month: Halloween! 👻</h2>
				<p class="le-text">A spooky-cute limited print you can only download for <strong>one week every month</strong>. Grab it before it vanishes into the night! 🕸️</p>
				<button class="le-cta" id="le-cta">Ooooh, spooky! 🦇</button>
			</div>
		</div>

		{prints.length > 0 ? (
			<div class="prints-grid">
				{prints.map((print) => (
					<a href={`/3d-prints/${print.slug}`} class="print-card">
						<div class="print-thumb">
							<img src={print.images[0]} alt={print.title} loading="lazy" decoding="async" />
						</div>
						<div class="print-info">
							<h4>{print.title}</h4>
						</div>
					</a>
				))}
			</div>
		) : (
			<div class="prints-empty">
				<img src="/paw-icon.svg" alt="" width="40" height="40" class="prints-empty-paw" />
				<p>Coming soon! Check back for photos of my 3D prints and the files I used to make them.</p>
			</div>
		)}
	</section>
</Layout>

<style>
	.close-btn {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 2rem;
		color: #6B3E2E;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
		line-height: 1;
		opacity: 0.5;
		transition: opacity 0.2s;
	}
	.close-btn:hover {
		opacity: 1;
	}

	/* ===== Limited Edition corner tab ===== */
	.le-tab {
		position: fixed;
		top: 180px;
		left: 56px;
		z-index: 90;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.9rem 1.4rem;
		border: none;
		border-radius: 14px;
		cursor: pointer;
		font-family: 'Baloo 2', cursive;
		color: #fff;
		text-align: left;
		line-height: 1.05;
		background: linear-gradient(135deg, #4a2b7a, #7a3fb0);
		box-shadow: 0 4px 16px rgba(74, 43, 122, 0.4);
		border: 2px solid #ff8c1a;
		transition: transform 0.2s, box-shadow 0.2s;
		animation: le-tab-pulse 2.4s ease-in-out infinite;
	}
	.le-tab:hover {
		transform: translateY(-2px) scale(1.03);
		box-shadow: 0 6px 22px rgba(255, 140, 26, 0.5);
	}
	.le-tab-emoji { font-size: 2.4rem; }
	.le-tab-text { font-size: 1rem; font-weight: 700; }
	.le-tab-text small { font-size: 0.82rem; font-weight: 600; opacity: 0.85; }
	@keyframes le-tab-pulse {
		0%, 100% { box-shadow: 0 4px 16px rgba(74, 43, 122, 0.4); }
		50% { box-shadow: 0 4px 22px rgba(255, 140, 26, 0.6); }
	}

	/* ===== Halloween popup ===== */
	.le-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 400;
		background: rgba(20, 6, 30, 0.78);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		align-items: center;
		justify-content: center;
		padding: 1.25rem;
	}
	.le-overlay.open { display: flex; animation: le-fade 0.25s ease; }
	@keyframes le-fade { from { opacity: 0; } to { opacity: 1; } }

	.le-modal {
		position: relative;
		max-width: 700px;
		width: 100%;
		text-align: center;
		padding: 4rem 3rem 3.5rem;
		border-radius: 30px;
		color: #fff5e9;
		background: radial-gradient(circle at 50% 0%, #3d2459, #241038 70%);
		border: 3px solid #ff8c1a;
		box-shadow: 0 0 40px rgba(255, 140, 26, 0.45), inset 0 0 30px rgba(123, 63, 176, 0.4);
		animation: le-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	@keyframes le-pop { from { transform: scale(0.8) translateY(10px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }

	.le-close {
		position: absolute;
		top: 0.6rem;
		right: 0.9rem;
		background: none;
		border: none;
		color: #ffd9a8;
		font-size: 1.8rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.8;
	}
	.le-close:hover { opacity: 1; color: #ff8c1a; }

	.le-bats { display: flex; justify-content: center; align-items: center; gap: 1.1rem; margin-bottom: 0.2rem; }
	.le-bats img { width: 68px; height: auto; animation: le-float 3s ease-in-out infinite; }
	.le-bats img:nth-child(2) { animation-delay: 0.4s; }
	.le-bats img:nth-child(3) { animation-delay: 0.8s; }
	@keyframes le-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

	.le-pumpkin-img {
		display: block;
		width: 180px;
		max-width: 60%;
		height: auto;
		margin: 0.3rem auto 0.8rem;
		filter: drop-shadow(0 6px 18px rgba(255, 140, 26, 0.45));
		animation: le-wiggle 2.5s ease-in-out infinite;
	}
	@keyframes le-wiggle { 0%,100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }

	.le-badge {
		display: inline-block;
		background: #ff8c1a;
		color: #2a1038;
		font-family: 'Baloo 2', cursive;
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.35rem 1rem;
		border-radius: 999px;
		margin-bottom: 0.8rem;
	}
	.le-title {
		font-family: 'Baloo 2', cursive;
		font-size: 2.6rem;
		margin: 0 0 1rem;
		color: #ffce7a;
		text-shadow: 0 2px 8px rgba(255, 140, 26, 0.4);
	}
	.le-text {
		font-family: 'Nunito', sans-serif;
		font-size: 1.2rem;
		line-height: 1.65;
		margin: 0 0 1.8rem;
		opacity: 0.92;
	}
	.le-text strong { color: #ffce7a; }
	.le-cta {
		font-family: 'Baloo 2', cursive;
		font-weight: 700;
		font-size: 1.2rem;
		padding: 0.9rem 2.4rem;
		border: none;
		border-radius: 16px;
		cursor: pointer;
		color: #2a1038;
		background: linear-gradient(135deg, #ffb24d, #ff8c1a);
		box-shadow: 0 4px 16px rgba(255, 140, 26, 0.5);
		transition: transform 0.2s;
	}
	.le-cta:hover { transform: translateY(-2px) scale(1.04); }

	@media (max-width: 600px) {
		.le-tab { top: auto; bottom: 14px; padding: 0.5rem 0.75rem; }
		.le-tab-emoji { font-size: 1.3rem; }
		.le-modal { padding: 2.25rem 1.25rem 1.75rem; }
		.le-title { font-size: 1.35rem; }
	}

	.prints-section {
		max-width: 1100px;
		margin: 2rem auto;
		padding: 2.5rem 2rem;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.prints-section h2 {
		font-family: 'Baloo 2', cursive;
		font-size: 2rem;
		color: #6B3E2E;
		margin-bottom: 0.5rem;
	}

	.prints-subtitle {
		font-family: 'Nunito', sans-serif;
		font-size: 1rem;
		color: #6B3E2E;
		opacity: 0.7;
		margin-bottom: 2rem;
	}

	.prints-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.5rem;
		grid-auto-rows: min-content;
	}

	.print-card {
		display: flex;
		flex-direction: column;
		border-radius: 16px;
		overflow: hidden;
		background: #fff;
		box-shadow: 0 2px 12px rgba(107, 62, 46, 0.1);
		transition: all 0.25s;
		text-decoration: none;
	}

	.print-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 6px 20px rgba(107, 62, 46, 0.15);
	}

	.print-thumb {
		display: block;
		line-height: 0;
	}

	.print-thumb img {
		width: 100%;
		height: 100%;
		aspect-ratio: 1 / 1;
		object-fit: contain;
		display: block;
	}

	.print-info {
		padding: 1rem;
		text-align: center;
	}

	.print-info h4 {
		font-family: 'Baloo 2', cursive;
		font-size: 1rem;
		color: #6B3E2E;
		margin: 0;
	}

	.prints-empty {
		padding: 3rem 1.5rem;
		margin-bottom: 1rem;
	}

	.prints-empty-paw {
		opacity: 0.4;
		margin-bottom: 1rem;
	}

	.prints-empty p {
		font-family: 'Nunito', sans-serif;
		font-size: 1rem;
		color: #6B3E2E;
		opacity: 0.6;
		max-width: 420px;
		margin: 0 auto;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.prints-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1rem;
		}

		.prints-section {
			padding: 1.5rem 1rem;
		}

		.prints-section h2 {
			font-size: 1.6rem;
		}

		.close-btn {
			top: 1rem;
			right: 1rem;
			font-size: 1.75rem;
		}
	}

	@media (max-width: 480px) {
		.prints-section h2 {
			font-size: 1.4rem;
		}
	}
</style>

<script is:inline>
	(function () {
		function init() {
			var overlay = document.getElementById('le-overlay');
			if (!overlay) return;
			var tab = document.getElementById('le-tab');
			var open = function () { overlay.classList.add('open'); };
			var close = function () { overlay.classList.remove('open'); };
			var closeBtn = document.getElementById('le-close');
			var cta = document.getElementById('le-cta');
			if (closeBtn) closeBtn.addEventListener('click', close);
			if (cta) cta.addEventListener('click', close);
			overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
			if (tab) tab.addEventListener('click', open);
			open(); // pop up every time the 3D Prints page is opened
		}
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
	})();
</script>

---
import Layout from '../layouts/Layout.astro';
import { prints } from '../data/prints';
---

<Layout title="3D Prints - Japanezy Arts">
	<section class="prints-section">
		<a href="/" class="close-btn" aria-label="Back to home">&times;</a>
		<h2>3D Prints</h2>
		<p class="prints-subtitle">Photos of things I've 3D printed — plus the files I used to make them!</p>

		{prints.length > 0 ? (
			<div class="prints-grid">
				{prints.map((print) => (
					<a href={`/3d-prints/${print.slug}`} class="print-card">
						<div class="print-thumb">
							<img src={print.images[0]} alt={print.title} loading="lazy" decoding="async" />
						</div>
						<div class="print-info">
							<h4>{print.title}</h4>
						</div>
					</a>
				))}
			</div>
		) : (
			<div class="prints-empty">
				<img src="/paw-icon.svg" alt="" width="40" height="40" class="prints-empty-paw" />
				<p>Coming soon! Check back for photos of my 3D prints and the files I used to make them.</p>
			</div>
		)}
	</section>
</Layout>

<style>
	.close-btn {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 2rem;
		color: #6B3E2E;
		background: none;
		border: none;
		cursor: pointer;
		text-decoration: none;
		line-height: 1;
		opacity: 0.5;
		transition: opacity 0.2s;
	}
	.close-btn:hover {
		opacity: 1;
	}

	.prints-section {
		max-width: 1100px;
		margin: 2rem auto;
		padding: 2.5rem 2rem;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.prints-section h2 {
		font-family: 'Baloo 2', cursive;
		font-size: 2rem;
		color: #6B3E2E;
		margin-bottom: 0.5rem;
	}

	.prints-subtitle {
		font-family: 'Nunito', sans-serif;
		font-size: 1rem;
		color: #6B3E2E;
		opacity: 0.7;
		margin-bottom: 2rem;
	}

	.prints-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.5rem;
		grid-auto-rows: min-content;
	}

	.print-card {
		display: flex;
		flex-direction: column;
		border-radius: 16px;
		overflow: hidden;
		background: #fff;
		box-shadow: 0 2px 12px rgba(107, 62, 46, 0.1);
		transition: all 0.25s;
		text-decoration: none;
	}

	.print-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 6px 20px rgba(107, 62, 46, 0.15);
	}

	.print-thumb {
		display: block;
		line-height: 0;
	}

	.print-thumb img {
		width: 100%;
		height: 100%;
		aspect-ratio: 1 / 1;
		object-fit: contain;
		display: block;
	}

	.print-info {
		padding: 1rem;
		text-align: center;
	}

	.print-info h4 {
		font-family: 'Baloo 2', cursive;
		font-size: 1rem;
		color: #6B3E2E;
		margin: 0;
	}

	.prints-empty {
		padding: 3rem 1.5rem;
		margin-bottom: 1rem;
	}

	.prints-empty-paw {
		opacity: 0.4;
		margin-bottom: 1rem;
	}

	.prints-empty p {
		font-family: 'Nunito', sans-serif;
		font-size: 1rem;
		color: #6B3E2E;
		opacity: 0.6;
		max-width: 420px;
		margin: 0 auto;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.prints-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1rem;
		}

		.prints-section {
			padding: 1.5rem 1rem;
		}

		.prints-section h2 {
			font-size: 1.6rem;
		}

		.close-btn {
			top: 1rem;
			right: 1rem;
			font-size: 1.75rem;
		}
	}

	@media (max-width: 480px) {
		.prints-section h2 {
			font-size: 1.4rem;
		}
	}
</style>
